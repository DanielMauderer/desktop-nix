{
  "id": null,
  "uid": "home-server-nixos",
  "title": "Home server — NixOS updates",
  "description": "Update pipeline health: autoUpgrade result, pending reboot, nixpkgs staleness, generations and store growth. Series come from nixos-metrics.nix via the node exporter's textfile collector; edit modules/nixos/server/dashboards/nixos.json.",
  "tags": ["nixos", "updates"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "5m",
  "time": { "from": "now-30d", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "type": "stat",
      "title": "Reboot pending",
      "description": "Booted kernel/initrd differs from the activated generation. autoUpgrade runs with allowReboot = false, so nothing clears this on its own.",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "nixos_reboot_required",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "No", "color": "green", "index": 0 },
                "1": { "text": "Yes", "color": "orange", "index": 1 }
              }
            }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "type": "stat",
      "title": "Auto-upgrade",
      "description": "Current state of nixos-upgrade.service, from the node exporter's systemd collector. A healthy oneshot sits at inactive, so only the failed state is meaningful here — 'when did it last succeed' is the panel to the right.",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "id": 2,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(node_systemd_unit_state{name=\"nixos-upgrade.service\",state=\"failed\"})",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "not configured",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "OK", "color": "green", "index": 0 },
                "1": { "text": "FAILED", "color": "red", "index": 1 }
              }
            }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "type": "stat",
      "title": "Since last upgrade run",
      "description": "autoUpgrade fires daily with up to 45 min of randomised delay, so anything past ~2 days means the timer is not firing.",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "id": 3,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "time() - (nixos_unit_last_finish_timestamp_seconds{unit=\"nixos-upgrade.service\"} > 0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "noValue": "not since boot",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 172800 },
              { "color": "red", "value": 604800 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "type": "stat",
      "title": "nixpkgs age",
      "description": "Commit date of the nixpkgs this system was built from. update-lock.yml bumps flake.lock nightly and autoUpgrade consumes it daily, so a value climbing past a few days means one of those two stopped.",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "id": 4,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "time() - (nixos_nixpkgs_timestamp_seconds > 0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "noValue": "unknown",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 259200 },
              { "color": "red", "value": 1209600 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "type": "stat",
      "title": "Generation",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "id": 5,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "nixos_current_generation",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "type": "stat",
      "title": "Metrics freshness",
      "description": "Age of the file nixos-metrics.nix writes. The textfile collector never expires a stale file, so every value on this dashboard is only as trustworthy as this number — the timer runs hourly.",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "id": 6,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "time() - max(node_textfile_mtime_seconds)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "noValue": "no file",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 7200 },
              { "color": "red", "value": 21600 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "type": "timeseries",
      "title": "Time since each nightly job last finished",
      "description": "Sawtooth is healthy: each run resets its line to zero. A line that only climbs is a job that stopped running. Zero-valued series (never run since boot) are filtered out rather than drawn as a spike.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 10,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "time() - (nixos_unit_last_finish_timestamp_seconds > 0)",
          "legendFormat": "{{unit}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "fillOpacity": 0, "showPoints": "never", "lineWidth": 2 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "title": "Generations and store paths",
      "description": "Generations retained against entries in /nix/store. Both climbing together with no step down means nix-gc is not reclaiming — it runs weekly with --delete-older-than 30d.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 11,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "nixos_generation_count",
          "legendFormat": "generations retained"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "nixos_store_path_count",
          "legendFormat": "store paths"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "fillOpacity": 10, "showPoints": "never", "lineWidth": 2 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "store paths" },
            "properties": [{ "id": "custom.axisPlacement", "value": "right" }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "title": "Pending reboot",
      "description": "Steps to 1 when an upgrade lands a new kernel and drops back to 0 on the next boot. The width of each block is how long the box ran an outdated kernel.",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 12 },
      "id": 12,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "nixos_reboot_required",
          "legendFormat": "reboot required"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "decimals": 0,
          "custom": { "fillOpacity": 40, "showPoints": "never", "lineInterpolation": "stepAfter" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "hidden", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "type": "timeseries",
      "title": "Exit status of the nightly jobs",
      "description": "Non-zero is a failed run. Held until the unit runs again, so unlike the systemd collector's state metric this survives the unit going back to inactive.",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 12 },
      "id": 13,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "nixos_unit_last_exit_code",
          "legendFormat": "{{unit}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "custom": { "fillOpacity": 20, "showPoints": "never", "lineInterpolation": "stepAfter" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "title": "Failed systemd units",
      "description": "The whole-box view, not just the update units — the same series the host dashboard shows, repeated here because a failed upgrade usually drags something else down with it.",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 12 },
      "id": 14,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "node_systemd_unit_state{state=\"failed\"} > 0",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "custom": { "fillOpacity": 20, "showPoints": "never", "lineInterpolation": "stepAfter" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "logs",
      "title": "Update and garbage-collection log",
      "description": "The journal for the units above, so a red panel is one click from its cause. Loki keeps 90 days, the same window as the metrics.",
      "gridPos": { "h": 11, "w": 24, "x": 0, "y": 18 },
      "id": 20,
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{job=\"systemd-journal\", unit=~\"nixos-upgrade.service|nix-gc.service|nix-optimise.service|nixos-metrics.service\"}",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    }
  ]
}
