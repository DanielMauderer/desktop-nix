{
  "id": null,
  "uid": "home-server-fritz",
  "title": "FRITZ!Box — internet line",
  "description": "WAN throughput, data volume and line quality from the FRITZ!Box over TR-064 (fritz.nix, job=\"fritz\"). Current rates are the router's own byte-rate gauge; volumes are increase() over the WAN byte counters (64-bit on this firmware), which handles router reboots. DSL panels stay empty on cable/fibre. Edit modules/nixos/server/dashboards/fritz.json.",
  "tags": ["nixos", "fritzbox", "network"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "type": "stat",
      "title": "Download now",
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(fritz_wan_datarate_bytes{job=\"fritz\",direction=\"rx\"}) * 8",
          "legendFormat": "download"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "decimals": 1,
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "type": "stat",
      "title": "Upload now",
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 0 },
      "id": 2,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(fritz_wan_datarate_bytes{job=\"fritz\",direction=\"tx\"}) * 8",
          "legendFormat": "upload"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "decimals": 1,
          "color": { "mode": "fixed", "fixedColor": "orange" },
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "type": "stat",
      "title": "Downloaded (time range)",
      "description": "increase() of the WAN receive counter over the dashboard's time range.",
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 0 },
      "id": 3,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(fritz_wan_data_bytes_total{job=\"fritz\",direction=\"rx\"}[$__range]))",
          "legendFormat": "downloaded",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 2,
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "type": "stat",
      "title": "Uploaded (time range)",
      "description": "increase() of the WAN send counter over the dashboard's time range.",
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 0 },
      "id": 4,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(fritz_wan_data_bytes_total{job=\"fritz\",direction=\"tx\"}[$__range]))",
          "legendFormat": "uploaded",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 2,
          "color": { "mode": "fixed", "fixedColor": "orange" },
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "type": "stat",
      "title": "Online for",
      "description": "Uptime of the current PPP session — resets on every reconnect (including the provider's forced one).",
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 0 },
      "id": 5,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(fritz_ppp_connection_uptime_seconds_total{job=\"fritz\"})",
          "legendFormat": "online",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "green" },
          "noValue": "no PPP"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "type": "stat",
      "title": "Internet",
      "description": "Physical WAN link state. Red also when the exporter cannot reach the router at all.",
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 0 },
      "id": 6,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "min(fritz_wan_phys_link_status{job=\"fritz\"}) * min(up{job=\"fritz\"})",
          "legendFormat": "link",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "unreachable",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red", "index": 0 },
                "1": { "text": "UP", "color": "green", "index": 1 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "type": "timeseries",
      "title": "Throughput",
      "description": "Download above the axis, upload mirrored below it. Dashed lines are the line's sync rate — the ceiling the traffic can reach.",
      "gridPos": { "h": 11, "w": 24, "x": 0, "y": 5 },
      "id": 10,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(fritz_wan_datarate_bytes{job=\"fritz\",direction=\"rx\"}) * 8",
          "legendFormat": "download"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(fritz_wan_datarate_bytes{job=\"fritz\",direction=\"tx\"}) * 8",
          "legendFormat": "upload"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(fritz_wan_max_bitrate_bps{job=\"fritz\",direction=\"rx\"})",
          "legendFormat": "download line rate"
        },
        {
          "refId": "D",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(fritz_wan_max_bitrate_bps{job=\"fritz\",direction=\"tx\"})",
          "legendFormat": "upload line rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 35,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": 120000,
            "axisCenteredZero": false,
            "thresholdsStyle": { "mode": "off" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "download" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }]
          },
          {
            "matcher": { "id": "byName", "options": "upload" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } },
              { "id": "custom.transform", "value": "negative-Y" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "download line rate" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "dark-blue" } },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "custom.lineWidth", "value": 1 },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 6] } },
              { "id": "custom.lineInterpolation", "value": "stepAfter" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "upload line rate" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "dark-orange" } },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "custom.lineWidth", "value": 1 },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 6] } },
              { "id": "custom.lineInterpolation", "value": "stepAfter" },
              { "id": "custom.transform", "value": "negative-Y" }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "type": "gauge",
      "title": "Download utilisation",
      "description": "Current download rate as a share of the downstream sync rate.",
      "gridPos": { "h": 8, "w": 5, "x": 0, "y": 16 },
      "id": 20,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * 8 * sum(fritz_wan_datarate_bytes{job=\"fritz\",direction=\"rx\"}) / max(fritz_wan_max_bitrate_bps{job=\"fritz\",direction=\"rx\"})",
          "legendFormat": "download",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "noValue": "no data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showThresholdMarkers": true,
        "showThresholdLabels": false,
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "type": "gauge",
      "title": "Upload utilisation",
      "description": "Current upload rate as a share of the upstream sync rate.",
      "gridPos": { "h": 8, "w": 5, "x": 5, "y": 16 },
      "id": 21,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * 8 * sum(fritz_wan_datarate_bytes{job=\"fritz\",direction=\"tx\"}) / max(fritz_wan_max_bitrate_bps{job=\"fritz\",direction=\"tx\"})",
          "legendFormat": "upload",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "noValue": "no data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "orange", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showThresholdMarkers": true,
        "showThresholdLabels": false,
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "type": "timeseries",
      "title": "Data volume per day (last 30 days)",
      "description": "Each bar is the traffic in the 24 h ending at that point. Fixed to 30 days regardless of the dashboard time range.",
      "gridPos": { "h": 8, "w": 10, "x": 10, "y": 16 },
      "id": 22,
      "timeFrom": "30d",
      "interval": "1d",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(fritz_wan_data_bytes_total{job=\"fritz\",direction=\"rx\"}[1d]))",
          "legendFormat": "download",
          "interval": "1d"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(fritz_wan_data_bytes_total{job=\"fritz\",direction=\"tx\"}[1d]))",
          "legendFormat": "upload",
          "interval": "1d"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "barAlignment": -1,
            "fillOpacity": 80,
            "gradientMode": "hue",
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": { "mode": "normal" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "download" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }]
          },
          {
            "matcher": { "id": "byName", "options": "upload" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["sum", "mean"] },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "type": "bargauge",
      "title": "Last 30 days",
      "gridPos": { "h": 8, "w": 4, "x": 20, "y": 16 },
      "id": 23,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(fritz_wan_data_bytes_total{job=\"fritz\",direction=\"rx\"}[30d]))",
          "legendFormat": "download",
          "instant": true
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(fritz_wan_data_bytes_total{job=\"fritz\",direction=\"tx\"}[30d]))",
          "legendFormat": "upload",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "min": 0,
          "noValue": "no data",
          "color": { "mode": "fixed", "fixedColor": "blue" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "upload" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          }
        ]
      },
      "options": {
        "orientation": "vertical",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "type": "row",
      "title": "DSL line (empty on cable / fibre)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
      "id": 30,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Sync rate vs. attainable",
      "description": "Current DSL sync rate against what the line could attain. A widening gap after a resync means the line trained down.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "id": 31,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (direction, type) (fritz_dsl_datarate_kbps{job=\"fritz\"}) * 1000",
          "legendFormat": "{{direction}} {{type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "min": 0,
          "noValue": "not a DSL line",
          "custom": { "lineInterpolation": "stepAfter", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "rx curr" },
            "properties": [
              { "id": "displayName", "value": "download sync" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } },
              { "id": "custom.fillOpacity", "value": 15 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "rx max" },
            "properties": [
              { "id": "displayName", "value": "download attainable" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "dark-blue" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 6] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "tx curr" },
            "properties": [
              { "id": "displayName", "value": "upload sync" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } },
              { "id": "custom.fillOpacity", "value": 15 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "tx max" },
            "properties": [
              { "id": "displayName", "value": "upload attainable" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "dark-orange" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 6] } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "title": "Noise margin (SNR)",
      "description": "Headroom above the noise floor. Below ~6 dB the line starts resyncing or gathering CRC errors.",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 25 },
      "id": 32,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (direction) (fritz_dsl_noise_margin_dB{job=\"fritz\"})",
          "legendFormat": "{{direction}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dB",
          "noValue": "not a DSL line",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "thresholdsStyle": { "mode": "line+area" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "transparent", "value": 6 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "rx" },
            "properties": [
              { "id": "displayName", "value": "download" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "tx" },
            "properties": [
              { "id": "displayName", "value": "upload" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "type": "timeseries",
      "title": "Line errors",
      "description": "CRC errors are corrupted frames the line could not repair; FEC are the ones forward error correction fixed. A steady CRC rate means a noisy line.",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 25 },
      "id": 33,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(fritz_dsl_crc_errors_count_total{job=\"fritz\"}[$__rate_interval]))",
          "legendFormat": "CRC"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(fritz_dsl_fec_errors_count_total{job=\"fritz\"}[$__rate_interval]))",
          "legendFormat": "FEC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "not a DSL line",
          "custom": { "drawStyle": "bars", "fillOpacity": 70, "lineWidth": 1, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "CRC" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "FEC" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["sum"] },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "type": "row",
      "title": "Router and home network",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 33 },
      "id": 40,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Wi-Fi clients",
