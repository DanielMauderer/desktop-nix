{
  "uid": "home-logs",
  "title": "Home server / Logs",
  "tags": ["home-server"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "unit",
        "label": "systemd unit",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values({job=\"systemd-journal\"}, unit)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": { "text": ["All"], "value": ["$__all"] }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Journal volume by unit",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 40, "stacking": { "mode": "normal" }, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "topk(10, sum by (unit) (count_over_time({job=\"systemd-journal\", unit=~\"$unit\"}[$__auto])))",
          "legendFormat": "{{unit}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Errors and worse",
      "description": "Journal priority err/crit/alert/emerg. The `level` label comes from Alloy's relabel of the journal's priority keyword.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 40, "stacking": { "mode": "normal" }, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (unit) (count_over_time({job=\"systemd-journal\", unit=~\"$unit\", level=~\"err|crit|alert|emerg\"}[$__auto]))",
          "legendFormat": "{{unit}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Journal",
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{job=\"systemd-journal\", unit=~\"$unit\"}"
        }
      ]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Authentication and privilege",
      "description": "sudo reaches the journal through authpriv; audit events reach it through auditd's syslog plugin (see logs.nix). Neither needs its file read off disk.",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 22 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{syslog_identifier=~\"sudo|sshd|audisp-syslog\"}"
        }
      ]
    }
  ]
}
